{
  "name": "timeswap",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "npm run test -w @timeswap/engine && npm run test -w web",
    "typecheck": "tsc -p packages/engine/tsconfig.json --noEmit && npm run typecheck -w web",
    "build": "npm run build -w web",
    "demo": "npm run demo -w @timeswap/engine --",
    "dev": "npm run dev -w web",
    "serve": "node scripts/serve-checked.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check-config.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
